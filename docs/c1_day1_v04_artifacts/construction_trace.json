  "excluded_short_leadins_before_lists": [
    {
      "lead_in_id": "K2-bc48820222eb1a9724fc",
      "lead_in_text": "Regular exercise and physical activity may:",
      "following_block_id": "K2-24218818d2c2224c4637",
      "anchor_id": "medlineplus:6601:full-summary"
    },
    {
      "lead_in_id": "K2-3548ce191c136e742199",
      "lead_in_text": "There are three main types of carbohydrates:",
      "following_block_id": "K2-cd45e381f8eb67472510",
      "anchor_id": "medlineplus:3670:full-summary"
    },
    {
      "lead_in_id": "K2-eae085177077cb0128e1",
      "lead_in_text": "Common foods with carbohydrates include:",
      "following_block_id": "K2-3c10244cfdbc119a9299",
      "anchor_id": "medlineplus:3670:full-summary"
    },
    {
      "lead_in_id": "K2-cbd097e3d555911556f3",
      "lead_in_text": "Good sources of dietary fiber include:",
      "following_block_id": "K2-3b25839ee8ab0d74a603",
      "anchor_id": "medlineplus:3059:full-summary"
    },
    {
      "lead_in_id": "K2-8ca00cf7451791fc8015",
      "lead_in_text": "A few main types of exercise include:",
      "following_block_id": "K2-d4ddf8b2ff2c68eead9c",
      "anchor_id": "medlineplus:490:full-summary"
    },
    {
      "lead_in_id": "K2-f405854bd225e400d942",
      "lead_in_text": "A healthy lifestyle for older adults includes:",
      "following_block_id": "K2-568377142a135a05faeb",
      "anchor_id": "medlineplus:5704:full-summary"
    },
    {
      "lead_in_id": "K2-8d11148d67fb2ca8e567",
      "lead_in_text": "Sleep deprivation can also affect your mood, leading to:",
      "following_block_id": "K2-9b6c8256d8baaf1c65b6",
      "anchor_id": "medlineplus:6469:full-summary"
    },
    {
      "lead_in_id": "K2-f2e21691adcb8aa18394",
      "lead_in_text": "To improve your sleep habits, it also may help to:",
      "following_block_id": "K2-29d22c29d67be3c197c5",
      "anchor_id": "medlineplus:6469:full-summary"
    },
    {
      "lead_in_id": "K2-750ec86fa8872f6ed9ae",
      "lead_in_text": "Also, do strengthening activities two or more days per week:",
      "following_block_id": "K2-045a7759680b805de4f8",
      "anchor_id": "medlineplus:6603:full-summary"
    },
    {
      "lead_in_id": "K2-b5a5958564de1196dd4a",
      "lead_in_text": "In general, a healthy eating plan includes:",
      "following_block_id": "K2-4dff997414a191d8f86a",
      "anchor_id": "medlineplus:36:full-summary"
    },
    {
      "lead_in_id": "K2-979bb370c6ba0a26e880",
      "lead_in_text": "To stay healthy as you age, you should:",
      "following_block_id": "K2-37824cc4afa5a2a06fd9",
      "anchor_id": "medlineplus:1616:full-summary"
    },
    {
      "lead_in_id": "K2-76bb59fc66b7d7be0855",
      "lead_in_text": "Causes of long-term stress include:",
      "following_block_id": "K2-1321d9e1a73467f30e8c",
      "anchor_id": "medlineplus:422:full-summary"
    },
    {
      "lead_in_id": "K2-0baab554c73d52c950a8",
      "lead_in_text": "Always get help right away if stress is causing you to:",
      "following_block_id": "K2-a36f50b000c8162752f0",
      "anchor_id": "medlineplus:422:full-summary"
    },
    {
      "lead_in_id": "K2-7c6b5f28808cd1134444",
      "lead_in_text": "To help prevent heart disease, you can:",
      "following_block_id": "K2-ab17cfdb08d654b03e01",
      "anchor_id": "myhealthfinder:25:0:The Basics: Overview"
    },
    {
      "lead_in_id": "K2-93ba9dbc09c3851a1961",
      "lead_in_text": "Some common signs and symptoms of a heart attack include:",
      "following_block_id": "K2-e6262f0ff49a93754648",
      "anchor_id": "myhealthfinder:25:2:Take Action: Know the Signs of a Heart Attack"
    },
    {
      "lead_in_id": "K2-f49d76066608d9fa939d",
      "lead_in_text": "Heart-healthy items include:",
      "following_block_id": "K2-67b241c781de4e9b7da1",
      "anchor_id": "myhealthfinder:25:6:Take Action: Eat Real Food"
    },
    {
      "lead_in_id": "K2-b24debb69c9cc6eb0172",
      "lead_in_text": "Try to limit foods that:",
      "following_block_id": "K2-02aae8028b8401310d6f",
      "anchor_id": "myhealthfinder:25:6:Take Action: Eat Real Food"
    },
    {
      "lead_in_id": "K2-1660054ae792cc5f98d4",
      "lead_in_text": "You can also check out these heart-healthy recipe collections:",
      "following_block_id": "K2-57d24f75f8cd7733ac2f",
      "anchor_id": "myhealthfinder:25:6:Take Action: Eat Real Food"
    },
    {
      "lead_in_id": "K2-f957db65f6529c42665c",
      "lead_in_text": "Kids need even more sleep than adults:",
      "following_block_id": "K2-db49b0399fa678d75520",
      "anchor_id": "myhealthfinder:30533:0:The Basics: Overview"
    },
    {
      "lead_in_id": "K2-0bea6d6cc9de72d21e2e",
      "lead_in_text": "Getting enough sleep has many benefits. It can help you:",
      "following_block_id": "K2-ba8fb9fd0df7c896198d",
      "anchor_id": "myhealthfinder:30533:1:The Basics: Health Benefits"
    },
    {
      "lead_in_id": "K2-f3eb6a67498a51b80f16",
      "lead_in_text": "Get sleep tips to help you:",
      "following_block_id": "K2-f202e8940b19323b8b4b",
      "anchor_id": "myhealthfinder:30533:2:The Basics: Sleep Schedule"
    },
    {
      "lead_in_id": "K2-1e30b13556f49a8f5c7a",
      "lead_in_text": "Many things can make it harder for you to sleep, including:",
      "following_block_id": "K2-ee1da7a8d55f1bf35a3f",
      "anchor_id": "myhealthfinder:30533:3:The Basics: Trouble Sleeping"
    },
    {
