              "necessary",
              "optional",
              "alternative",
              "restriction",
              "uncertain"
            ]
          },
          "logic": {
            "type": "string",
            "enum": [
              "ALL",
              "ANY",
              "UNKNOWN"
            ]
          },
          "probe_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dataset_support": {
            "type": "string",
            "enum": [
              "supported",
              "partial",
              "unsupported",
              "uncertain"
