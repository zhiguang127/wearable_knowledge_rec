            "enum": [
              "applicability",
              "sufficiency",
              "priority",
              "explanation"
            ]
          }
        },
        "required": [
          "condition_id",
          "text",
          "role",
          "logic",
          "probe_ids",
          "dataset_support",
          "source_citations",
          "insufficient_information",
          "use"
