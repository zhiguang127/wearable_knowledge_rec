      "type": "boolean"
    },
    "independently_recommendable": {
      "type": "boolean"
    },
    "education_only": {
      "type": "boolean"
    },
    "normalized_text": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "role": {
            "type": "string",
